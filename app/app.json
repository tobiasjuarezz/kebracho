{
  "expo": {
    "name": "Kebracho",
    "slug": "kebracho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kebracho",
    "userInterfaceStyle": "dark",
    "ios": {
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kebracho usa Face ID para que puedas ingresar a tu cuenta y confirmar tus compras de forma segura."
      },
      "bundleIdentifier": "com.tobiasjuarez.kebracho"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B2B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "package": "com.tobiasjuarez.kebracho"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2B2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
